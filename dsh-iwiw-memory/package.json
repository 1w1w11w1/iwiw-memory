{
  "name": "dsh-iwiw-memory",
  "version": "0.1.1",
  "description": "IwIw 记忆插件：跨会话记忆，模型自主调用记忆工具（桥接 memory_agent MCP 内核）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "build:client": "node build.mjs",
    "release": "node scripts/release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "1w1w11w1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1w1w11w1/iwiw-memory.git",
    "directory": "dsh-iwiw-memory"
  },
  "homepage": "https://github.com/1w1w11w1/iwiw-memory#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "long-term-memory",
    "memory",
    "mcp",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
