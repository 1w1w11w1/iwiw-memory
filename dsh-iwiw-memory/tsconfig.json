{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/client.ts",
    "src/client-fold.ts",
    "src/client-delegate-vanish.ts",
    "src/client-delegate-notice.ts",
    "src/client-dream-events.ts",
    "src/client-dream-icon.ts",
    "src/client-dream-skip.ts",
    "src/settings-page.ts"
  ]
}