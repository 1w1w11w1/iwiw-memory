# Copy to .env and fill local secrets. Do not commit .env.

# DeepSeek Anthropic-compatible endpoint by default.
MEMORY_AGENT_LLM_API_STYLE=anthropic
MEMORY_AGENT_LLM_BASE_URL=https://api.deepseek.com/anthropic
MEMORY_AGENT_LLM_MODEL=deepseek-v4-flash
MEMORY_AGENT_LLM_API_KEY=

# Hook behavior.
MEMORY_AGENT_HOOK_REPORT_STATUS=false
MEMORY_AGENT_SKIP_IDE_CONTEXT=true
