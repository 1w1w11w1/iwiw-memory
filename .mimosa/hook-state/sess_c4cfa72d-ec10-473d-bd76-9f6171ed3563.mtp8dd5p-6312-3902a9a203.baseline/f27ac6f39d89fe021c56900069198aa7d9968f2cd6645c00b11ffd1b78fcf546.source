{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m memory_agent.hook_extractor",
            "timeout": 25,
            "async": true
          }
        ]
      }
    ]
  },
  "env": {
    "PYTHONIOENCODING": "utf-8"
  }
}
