def build_conversation():
    """生成 96 轮（万字级）对话：前 2/3 埋点+讨论（expect 空），后 1/3 长程回指（expect 标注）。"""
    turns = []
    topics = list(TOPICS.items())
    for idx, (slug, t) in enumerate(topics):
        turns.append({'role': 'user', 'content': t['plant'], 'topic': slug})
        turns.append({'role': 'assistant', 'content': ASSISTANT[idx % len(ASSISTANT)]})
        turns.append({'role': 'user', 'content': t['plant2'], 'topic': slug})
        turns.append({'role': 'assistant', 'content': ASSISTANT[(idx + 1) % len(ASSISTANT)]})
        turns.append({'role': 'user', 'content': DISCUSS[slug], 'topic': slug})
        turns.append({'role': 'assistant', 'content': ASSISTANT[(idx + 2) % len(ASSISTANT)]})
        turns.append({'role': 'user', 'content': DISCUSS2[slug], 'topic': slug})
        turns.append({'role': 'assistant', 'content': ASSISTANT[(idx + 3) % len(ASSISTANT)]})
        if idx % 2 == 1:
            turns.append({'role': 'user', 'content': FILLERS[idx % len(FILLERS)]})
            turns.append({'role': 'assistant', 'content': ASSISTANT[(idx + 1) % len(ASSISTANT)]})
    # 长程回指（逆序）
    for idx, (slug, t) in enumerate(reversed(topics)):
        turns.append({'role': 'user', 'content': t['recall'], 'expect': t['expect']})
        turns.append({'role': 'assistant', 'content': '这个我能帮你分析，结合你之前说的情况一起看。你上次跟我说的那些，我都记着呢，咱们一条一条理清楚。放心，我不是那种你说了就忘的系统，相关的背景我都还带着，你说的每一件事在我这里都有对应的上下文，所以你不用反复重复背景，直接说重点就行，我要是哪里接不上，会主动问你。'})
        if idx % 2 == 1:
            turns.append({'role': 'user', 'content': FILLERS[(idx + 5) % len(FILLERS)]})
            turns.append({'role': 'assistant', 'content': '好，我们继续，你慢慢说。'})
    return turns


if __name__ == '__main__':
    c = build_conversation()
    total = sum(len(t['content']) for t in c)
    print('turns:', len(c), 'chars:', total)
